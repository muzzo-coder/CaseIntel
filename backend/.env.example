# ==============================================================================
# CaseIntel Backend - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
DEBUG=True

# Application Metadata
PROJECT_NAME="CaseIntel API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
# Supports JSON array (e.g. ["http://localhost:5173"]) or comma-separated string
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection URL
# For Local Development / Testing:
# DATABASE_URL=sqlite:///./caseintel.db
# For PostgreSQL (Production & Staging):
DATABASE_URL=postgresql+psycopg://caseintel_user:caseintel_password@localhost:5432/caseintel_db

# Database Connection Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Structured Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Set to True in production to output structured JSON logs
LOG_JSON_FORMAT=False

# Authentication & Security
# Generate secure 64-character secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email & SMTP Delivery Configuration
# To enable real email delivery over the internet, set EMAILS_ENABLED=True and configure SMTP below:
EMAILS_ENABLED=False
FRONTEND_URL=http://localhost:5173

# Example for Gmail SMTP (requires 2-Step Verification and a Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=True
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_google_app_password
# EMAILS_FROM_EMAIL=your_email@gmail.com
# EMAILS_FROM_NAME="CaseIntel Support"

# Example for SendGrid / Brevo / Resend / Mailgun:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_TLS=True
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_sendgrid_api_key
# EMAILS_FROM_EMAIL=support@yourdomain.com
# EMAILS_FROM_NAME="CaseIntel Support"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@caseintel.com
EMAILS_FROM_NAME="CaseIntel Support"
